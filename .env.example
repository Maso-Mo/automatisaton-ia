# ---------------------------------------------------------------------------
# Automatisation IA — configuration locale (étape 12)
#
# Copier ce fichier en `.env` (non versionné) puis compléter les clés.
# `pnpm setup` le fait pour vous et génère les deux clés cryptographiques.
#
# Règle du dépôt (docs/07 §4.2) : toute variable lue par `packages/config` DOIT
# figurer ici — un test échoue sinon. **Aucune vraie clé n'est versionnée** : les
# valeurs laissées vides sont soit optionnelles, soit à renseigner par vous.
#
# Catégories :
#   [REQUIRED]     obligatoires au démarrage (refus de démarrer sinon)
#   [OPTIONAL]     génériques, facultatifs (l'absence dégrade une fonction)
#   [SOCIAL APIs]  identifiants OAuth des plateformes de publication
#   [AI]           fournisseurs de modèles de langage
#   [MEDIA]        transcription, vidéo, stockage des médias
#   [REMOTE ACCESS] exposition réseau local et accès distant
#   [SECURITY]     clés cryptographiques et protection d'accès
# ---------------------------------------------------------------------------

# ===========================================================================
# [REQUIRED] — obligatoires au démarrage
# ===========================================================================
# Générer chacune avec : openssl rand -hex 32
# SESSION_SECRET signe les sessions locales.
SESSION_SECRET=
# ENCRYPTION_KEY chiffre les jetons de plateformes (AES-256-GCM, 64 hex).
ENCRYPTION_KEY=

# ===========================================================================
# [OPTIONAL] — application, base, file de jobs
# ===========================================================================
# Environnement : development | test | production
APP_ENV=development
# Interface d'écoute. 127.0.0.1 par défaut. N'utilisez PAS 0.0.0.0 (refusé au
# démarrage : exposerait tous les jetons). Pour le réseau local, mettez l'IP
# locale de la machine (ex. 192.168.1.20) — voir [REMOTE ACCESS].
APP_HOST=127.0.0.1
# Port de l'API. Fixe : enregistré comme URL de redirection OAuth.
APP_PORT=4317
# URL publique de l'application (origine autorisée en CORS). En LAN, mettre
# l'URL réellement utilisée : http://192.168.1.20:4317
APP_URL=http://127.0.0.1:4317
# Niveau de journalisation : trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# true = journaux lisibles en développement, false = JSON structuré
LOG_PRETTY=true
# Dossier des journaux fichier (rotation par taille). Vide = sortie standard.
LOG_DIR=
LOG_MAX_BYTES=5000000
LOG_MAX_FILES=5

# Chemin du fichier SQLite (créé au premier démarrage).
DATABASE_URL=file:./data/app.db
# WAL : un lecteur ne bloque jamais un écrivain (docs/03 §17.3).
DB_WAL=true
# Attente maximale en cas de base verrouillée (ms).
DB_BUSY_TIMEOUT_MS=5000
# Dossier des sauvegardes locales (base et médias séparés, docs/11 D5).
BACKUP_DIR=backups

# Jobs simultanés maximum. SQLite n'a qu'un écrivain : 3 est la limite assumée.
QUEUE_CONCURRENCY=3
# Intervalle de la boucle du worker (ms).
WORKER_POLL_MS=60000
# Durée du lease d'un job standard (ms).
JOB_LEASE_MS=60000
# Intervalle de battement de cœur pendant l'exécution d'un job (ms).
JOB_HEARTBEAT_MS=10000
# true = le worker ne réserve pas les jobs qui exigent le réseau.
OFFLINE_MODE=false
# Dossier des prompts versionnés et synchronisés au démarrage.
PROMPTS_DIR=prompts

# ===========================================================================
# [AI] — fournisseurs de modèles
# ===========================================================================
# Fournisseur par défaut : deepseek | openrouter | openai | anthropic | gemini | ollama
LLM_DEFAULT_PROVIDER=deepseek
# Modèles par défaut de la table de routage (docs/08 §9.1).
LLM_MODEL_LIGHT=
LLM_MODEL_STANDARD=
# Une clé absente NE bloque PAS le démarrage : signalée « non configurée ».
# Les valeurs ne doivent jamais être journalisées (docs/07 §4.3).
DEEPSEEK_API_KEY=
# `deepseek-chat` pour économiser, `deepseek-reasoner` quand la fiche maître compte.
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Modèles locaux : aucune clé requise.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ===========================================================================
# [MEDIA] — transcription, vidéo, stockage
# ===========================================================================
# Driver de stockage des médias : local (V1) | s3
STORAGE_DRIVER=local
# Racine des médias sur le disque local.
MEDIA_ROOT=data/media
# Taille maximale d'un upload (Mo).
MEDIA_MAX_UPLOAD_MB=512
# Durée maximale d'un enregistrement vocal (s), vérifiée après décodage.
MEDIA_MAX_DURATION_S=900
# Stockage S3/Cloudflare R2 — laisser vide tant que STORAGE_DRIVER=local.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Moteur de transcription : whisper_cpp | faster_whisper | cloud
ASR_ENGINE=whisper_cpp
# Binaires locaux (étape 3). Absents = dégradé, jamais bloquant.
# Sont requis : le binaire ET le modèle. Sinon la transcription locale n'est pas
# configurée (l'application démarre quand même, l'UI l'indique).
WHISPER_BIN=whisper-cli
WHISPER_MODEL_PATH=data/models/ggml-small.bin

# Binaires système (étape 7). Absents = dégradé, jamais bloquant.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Durée maximale d'un extrait rendu (s).
VIDEO_MAX_CLIP_S=180
# Délai maximal d'un encodage (ms) : au-delà, FFmpeg est tué et le rendu repris.
VIDEO_RENDER_TIMEOUT_MS=900000

# ===========================================================================
# [SOCIAL APIs] — identifiants OAuth (étapes 5 à 9)
# ===========================================================================
# Un connecteur sans identifiants apparaît « non configuré » dans l'interface.
# Aucune publication réelle n'est faite sans capacités acquises + confirmation.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Version d'API LinkedIn, format AAAAMM. VOLONTAIREMENT VIDE : LinkedIn
# déprécie ses versions ; tant qu'elle est vide, les comptes LinkedIn restent en
# niveau C (paquet manuel) plutôt que de figer une version périmée.
LINKEDIN_API_VERSION=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Publication par API (étape 8).
PUBLISH_MAX_ATTEMPTS=2
PUBLISH_ESTIMATED_COST_USD=0
# Décision D4 (docs/11 §3.4) : fréquence de collecte des statistiques, en heures.
METRICS_COLLECT_INTERVAL_HOURS=24

# Budget.
MONTHLY_BUDGET_USD=5
DAILY_BUDGET_USD=1
DAILY_TOKEN_LIMIT=2000000
REQUIRE_APPROVAL_ABOVE_USD=0

# ===========================================================================
# [REMOTE ACCESS] — réseau local et accès distant
# ===========================================================================
# L'application n'écoute QUE sur l'interface donnée par APP_HOST.
#   - localhost          : APP_HOST=127.0.0.1 (défaut, rien n'est exposé)
#   - réseau local (LAN) : APP_HOST=<IP locale>, APP_URL=http://<IP>:4317
#   - accès distant      : ne PAS ouvrir de port du routeur. Utiliser un tunnel
#                          chiffré (Tailscale recommandé) et garder APP_HOST
#                          sur l'IP Tailscale. Voir docs/22 §11.
# Dès que l'application est joignable autrement que par le poste, protégez-la :
#   AUTH_TOKEN=$(openssl rand -hex 32)
# (voir [SECURITY]). Le Wi-Fi n'est PAS une authentification.

# ===========================================================================
# [SECURITY] — clés cryptographiques et protection d'accès
# ===========================================================================
# Protection d'accès optionnelle. Vide = accès local non protégé (défaut sûr
# tant qu'APP_HOST reste 127.0.0.1). Renseignée = en-tête obligatoire
# `Authorization: Bearer <jeton>` sur toutes les routes sauf /health et /ready.
# Rotation : régénérer la valeur ici, redémarrer API et worker (aucune donnée
# n'est chiffrée avec ce jeton — il ne fait que garder l'accès).
AUTH_TOKEN=
