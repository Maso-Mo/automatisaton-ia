# ---------------------------------------------------------------------------
# Automatisation IA — configuration locale
#
# Copier ce fichier en `.env` (non versionné) puis compléter les clés.
# Toute variable lue par packages/config DOIT figurer ici : un test échoue sinon
# (docs/07 §4.2 — « .env.example à jour »).
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Environnement d'exécution : development | test | production
APP_ENV=development
# Interface d'écoute. 127.0.0.1 et JAMAIS 0.0.0.0 : la valeur 0.0.0.0 est refusée
# au démarrage, elle exposerait tous les jetons de publication au réseau (docs/07 §3.1).
APP_HOST=127.0.0.1
# Port de l'API. Fixe : il est enregistré tel quel comme URL de redirection OAuth.
APP_PORT=4317
# URL publique de l'application (origine autorisée en CORS).
APP_URL=http://127.0.0.1:4317
# Niveau de journalisation : trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# true = journaux lisibles en développement, false = JSON structuré
LOG_PRETTY=true

# --- Base de données -------------------------------------------------------
# Chemin du fichier SQLite (créé au premier démarrage).
DATABASE_URL=file:./data/app.db
# WAL : un lecteur ne bloque jamais un écrivain (docs/03 §17.3).
DB_WAL=true
# Attente maximale en cas de base verrouillée (ms).
DB_BUSY_TIMEOUT_MS=5000

# --- Stockage --------------------------------------------------------------
# Driver de stockage des médias : local (V1) | s3 (étape 12)
STORAGE_DRIVER=local
# Racine des médias sur le disque local.
MEDIA_ROOT=data/media
# Taille maximale d'un upload (Mo).
MEDIA_MAX_UPLOAD_MB=512
# Stockage S3/Cloudflare R2 — laisser vide tant que STORAGE_DRIVER=local.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- IA --------------------------------------------------------------------
# Fournisseur par défaut : deepseek | openrouter | openai | anthropic | gemini | ollama
LLM_DEFAULT_PROVIDER=deepseek
# Modèles par défaut de la table de routage (docs/08 §9.1).
LLM_MODEL_LIGHT=
LLM_MODEL_STANDARD=
# Clés des fournisseurs. Une clé absente ne bloque PAS le démarrage : elle est
# signalée « non configurée » dans l'interface (docs/02 §11). Les valeurs ne
# doivent jamais être journalisées, même tronquées (docs/07 §4.3).
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Modèles locaux : aucune clé requise.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Transcription ---------------------------------------------------------
# Moteur de transcription : whisper_cpp | faster_whisper | cloud
ASR_ENGINE=whisper_cpp
# Binaires locaux (étape 3). Absents = dégradé, jamais bloquant.
WHISPER_BIN=whisper-cli
WHISPER_MODEL_PATH=data/models/ggml-small.bin

# --- Vidéo -----------------------------------------------------------------
# Binaires système (étape 7). Absents = dégradé, jamais bloquant.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- Plateformes -----------------------------------------------------------
# Clés d'application OAuth (étapes 5 à 9). Un connecteur sans identifiants
# apparaît « non configuré » dans l'interface.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Budget ----------------------------------------------------------------
# Budget mensuel de référence du cahier des charges : 5 USD (docs/08 §8.1).
MONTHLY_BUDGET_USD=5
# Plafond journalier (défaut sûr).
DAILY_BUDGET_USD=1
# Plafond de jetons par jour, tous fournisseurs confondus.
DAILY_TOKEN_LIMIT=2000000
# Au-delà de ce montant, une validation est demandée avant chaque appel coûteux.
REQUIRE_APPROVAL_ABOVE_USD=0

# --- Sécurité (clés cryptographiques) --------------------------------------
# OBLIGATOIRES. Générer avec : openssl rand -hex 32
# SESSION_SECRET signe les sessions locales.
SESSION_SECRET=
# ENCRYPTION_KEY chiffre les jetons de plateformes (AES-256-GCM, 64 caractères hex).
ENCRYPTION_KEY=

# --- File de jobs ----------------------------------------------------------
# Jobs simultanés maximum. SQLite n'a qu'un écrivain : 3 est la limite assumée (docs/05 §10.2).
QUEUE_CONCURRENCY=3
# Intervalle de la boucle du worker (ms). Un nouveau job est réservé immédiatement
# après la fin du précédent, sans attendre ce délai.
WORKER_POLL_MS=60000
# Durée du lease d'un job standard (ms) — 5 min pour un rendu vidéo.
JOB_LEASE_MS=60000
# Intervalle de battement de cœur pendant l'exécution d'un job (ms).
JOB_HEARTBEAT_MS=10000
# true = le worker ne réserve pas les jobs qui exigent le réseau.
OFFLINE_MODE=false

# --- Chemins locaux --------------------------------------------------------
# Dossier des prompts versionnés par git, synchronisés dans `prompt_versions` au démarrage.
PROMPTS_DIR=prompts
