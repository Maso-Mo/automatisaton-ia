# ---------------------------------------------------------------------------
# Dépendances
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/

# ---------------------------------------------------------------------------
# Build / sortie
# ---------------------------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo
.turbo/
.cache/
coverage/

# ---------------------------------------------------------------------------
# Données locales (base, médias, exports) — ne doivent JAMAIS être commités.
#
# Tout vit sous `data/` : le dossier par défaut des médias est `data/media`
# (voir MEDIA_ROOT dans .env.example). C'est volontaire — ignorer un dossier
# nommé `media/` masquerait aussi `packages/media/` et `prompts/media/`, ce qui
# a réellement eu lieu lors de l'étape 1 (fichiers jamais ajoutés à git).
# ---------------------------------------------------------------------------
data/
/tmp/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# ---------------------------------------------------------------------------
# Sauvegardes locales et exports utilisateur (étape 12)
#
# Une sauvegarde contient une copie de la base et des médias : elle ne doit
# jamais entrer dans le dépôt (secrets chiffrés, données personnelles).
# ---------------------------------------------------------------------------
backups/
exports/

# ---------------------------------------------------------------------------
# Secrets et configuration locale
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
client_secret_*.json

# ---------------------------------------------------------------------------
# Outils / éditeurs
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/
nohup.out

# ---------------------------------------------------------------------------
# Documents de travail non destinés au dépôt
# ---------------------------------------------------------------------------
*.docx
*.odt

# ---------------------------------------------------------------------------
# Sorties des parcours navigateur (Playwright)
#
# Les traces ne sont écrites qu'en cas d'échec (`trace: 'retain-on-failure'`) :
# elles contiennent des captures d'écran du produit, jamais commitées. La base
# du parcours, elle, vit sous `data/` et est déjà ignorée.
# ---------------------------------------------------------------------------
test-results/
playwright-report/
blob-report/
.playwright/
